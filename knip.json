{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/extension.ts!",
    "src/integration/**/*.test.ts",
    "tests/**/*.test.ts",
    "scripts/*.mjs",
    ".vscode-test.mjs"
  ],
  "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.mjs"],
  "ignoreDependencies": ["@vscode/test-electron"]
}
